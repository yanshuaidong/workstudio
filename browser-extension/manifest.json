{
  "manifest_version": 3,
  "name": "东方财富",
  "version": "0.1.0",
  "description": "数据数据爬虫",
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "activeTab",
    "debugger",
    "scripting",
    "storage",
    "tabs",
    "windows"
  ],
  "host_permissions": [
    "https://quote.eastmoney.com/*",
    "https://data.eastmoney.com/*",
    "https://push2.eastmoney.com/*",
    "https://push2delay.eastmoney.com/*",
    "http://127.0.0.1:17890/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "打开采集控制台（独立页面）",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://quote.eastmoney.com/center/gridlist.html*",
        "https://data.eastmoney.com/zjlx/detail.html*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://quote.eastmoney.com/center/gridlist.html*",
        "https://data.eastmoney.com/zjlx/detail.html*"
      ],
      "js": [
        "src/inpage_hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
