{
  "name": "quant-pilot",
  "displayName": "Quant Pilot",
  "version": "0.1.0",
  "description": "东方财富数据采集控制台（Plasmo + React + Ant Design）",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "antd": "^6.3.7",
    "plasmo": "^0.90.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.281",
    "@types/node": "^22.13.14",
    "@types/react": "^18.3.13",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.8.3"
  },
  "manifest": {
    "manifest_version": 3,
    "name": "Quant Pilot",
    "description": "东方财富数据采集控制台",
    "action": {
      "default_title": "打开控制台（独立页面）"
    },
    "permissions": [
      "activeTab",
      "alarms",
      "debugger",
      "scripting",
      "storage",
      "tabs",
      "windows"
    ],
    "host_permissions": [
      "https://*.eastmoney.com/*",
      "http://127.0.0.1:*/*",
      "http://localhost:*/*"
    ]
  },
  "browserslist": [
    "Chrome >= 114"
  ]
}
